{
  "name": "sherlog-development",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "description": "Eval harness workspace for the native Sherlog CLI",
  "license": "MIT",
  "homepage": "https://github.com/catoncat/sherlog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catoncat/sherlog.git"
  },
  "bugs": {
    "url": "https://github.com/catoncat/sherlog/issues"
  },
  "keywords": [
    "codex",
    "claude-code",
    "pi",
    "cli",
    "fts",
    "search",
    "sqlite",
    "session"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "cargo build --release --locked --bin shlog",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "shlog": "cargo run --quiet --bin shlog --",
    "eval:manual": "tsx ./eval/run-manual-eval.ts",
    "eval:acceptance": "tsx ./eval/run-acceptance-eval.ts",
    "eval:contract": "tsx ./eval/run-contract-eval.ts",
    "eval:compare": "tsx ./eval/compare-eval-batches.ts",
    "eval:perf": "tsx ./eval/perf-bench.ts",
    "eval:perf:concurrency": "tsx ./eval/concurrency-bench.ts",
    "eval:dogfood": "tsx ./eval/run-dogfood-eval.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
